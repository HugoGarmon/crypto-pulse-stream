# ==============================================================================
# Global Configuration - Crypto Intelligence Streaming Platform
# ==============================================================================

# --- Redpanda / Kafka Configuration ---
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_EXTERNAL_SERVERS=localhost:19092
KAFKA_TOPIC_RAW_TRADES=raw-crypto-trades
KAFKA_TOPIC_PROCESSED_METRICS=processed-crypto-metrics

# --- ClickHouse OLAP Configuration ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=crypto_intelligence
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse123

# --- Producer / Binance Configuration ---
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443
TRACKED_SYMBOLS=btcusdt,ethusdt

# --- Stream Engine Configuration ---
ENGINE_MICROBATCH_SIZE=1000
ENGINE_MICROBATCH_INTERVAL_SEC=2.0
WHALE_THRESHOLD_USD=100000.0

# --- API & Gateway Configuration ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
